{
  "name": "Open in Freedium Fork",
  "version": "1.1.2",
  "manifest_version": 2,
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "browser_action": {
    "default_popup": "src/popup/options.html"
  },
  "options_ui": {
    "page": "src/popup/options.html",
    "open_in_tab": false
  },
  "icons": {
    "32": "src/icons/logo-32.png",
    "48": "src/icons/logo-48.png",
    "64": "src/icons/logo-64.png",
    "128": "src/icons/logo-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ayux-open-in-freedium-stable-fork@ayuxsec.dev",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
