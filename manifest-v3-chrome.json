{
  "name": "Open in Freedium",
  "version": "1.1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [],
  "action": {
    "default_popup": "src/options.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "icons": {
    "32": "src/logo-32.png",
    "48": "src/logo-48.png",
    "64": "src/logo-64.png",
    "128": "src/logo-128.png"
  }
}